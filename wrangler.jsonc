{
  // Cloudflare Worker for the NHL Win/Loss Lines site.
  "name": "nhl-predictions-data",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Your own domain (registered at Cloudflare). www forwards to the main address in worker/index.js.
  "routes": [
    { "pattern": "hockeypooler.com", "custom_domain": true },
    { "pattern": "www.hockeypooler.com", "custom_domain": true },
    { "pattern": "puck-off.com", "custom_domain": true },
    { "pattern": "www.puck-off.com", "custom_domain": true }
  ],
  "triggers": { "crons": ["23 * * * *"] },
  "workers_dev": true,
  // Hockey-pool database. Created automatically on first deploy.
  "d1_databases": [
    { "binding": "DB", "database_name": "nhl-pools" }
  ]
}
